{
  "name": "proofmark/verify-php",
  "description": "ProofMark Verify — PHP SDK for the CAPTCHA-replacement protocol (server-side token verification)",
  "type": "library",
  "license": "MIT",
  "keywords": ["proofmark", "captcha", "verification", "bot-prevention", "recaptcha-alternative", "turnstile-alternative"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": { "ProofMark\\Verify\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ProofMark\\Verify\\Tests\\": "tests/" }
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
