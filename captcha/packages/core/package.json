{
  "name": "@proofmark/verify-js",
  "version": "0.1.0",
  "description": "ProofMark Verify — framework-agnostic browser widget (CAPTCHA replacement)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api.js": "./dist/api.js"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {},
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": ["proofmark", "captcha", "verification", "bot-prevention", "recaptcha-alternative", "turnstile-alternative"],
  "license": "MIT",
  "author": "ProofMark",
  "engines": { "node": ">=18" }
}
