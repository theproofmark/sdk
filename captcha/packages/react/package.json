{
  "name": "@proofmark/verify-react",
  "version": "0.1.0",
  "description": "React binding for ProofMark Verify — drop-in <ProofMarkVerify> widget",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": ["proofmark", "captcha", "react", "verification", "turnstile-alternative"],
  "license": "MIT",
  "author": "ProofMark",
  "engines": { "node": ">=18" }
}
